<Window x:Class="AutoHealScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SmoothSight - Asia Integrated Machine Inc." Height="680" Width="1050" 
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1E293B">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Direction="270"/>
            </Grid.Effect>
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Scanner" FontSize="26" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="20" Foreground="#64748B" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="James Michael G. Biaton" TextWrapping="NoWrap" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Light / Dark Mode switch" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="ThemeToggle" Click="ThemeToggle_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#0F172A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="AVAILABLE SCANNERS" FontWeight="Heavy" FontSize="13" Foreground="#14B8A6" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10">
                        <ListBox x:Name="ListPrinters" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,6"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SYSTEM AUDIT LOGS" FontWeight="Heavy" FontSize="13" Foreground="#14B8A6" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10">
                        <ListBox x:Name="ListAuditLogs" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="#CBD5E1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,6"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Margin="0,0,0,25" UniformCornerRadius="12" Background="{DynamicResource MaterialDesignCardBackground}">
                    <Grid>
                        <TextBlock x:Name="TxtPreviewPlaceholder" Text="No document scanned or imported yet." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.4" FontStyle="Italic" FontSize="16"/>
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                        <WebBrowser x:Name="PdfViewer" Margin="10" Visibility="Collapsed"/>
                    </Grid>
                </materialDesign:Card>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnImport" Grid.Column="0" Content="IMPORT" Height="65" FontSize="18" FontWeight="Black" 
                            Click="BtnImport_Click" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="10" 
                            Background="#475569" BorderBrush="#475569" Foreground="White"/>

                    <Button x:Name="BtnPrint" Grid.Column="2" Content="PRINT" Height="65" FontSize="18" FontWeight="Black" 
                            Click="BtnPrint_Click" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="10" 
                            Background="#F59E0B" BorderBrush="#F59E0B" Foreground="White"/>

                    <Button x:Name="BtnScan" Grid.Column="4" Content="SCAN" Height="65" FontSize="18" FontWeight="Black" 
                            Click="BtnScan_Click" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="10" 
                            Background="#0D9488" BorderBrush="#0D9488" Foreground="White"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="AlertModal" Visibility="Collapsed" Grid.RowSpan="2" Background="#CC0F172A" Panel.ZIndex="10">
            <materialDesign:Card HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" UniformCornerRadius="15" Background="{DynamicResource MaterialDesignPaper}">
                <StackPanel Margin="30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="Alert" Foreground="#F59E0B" Width="35" Height="35" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAlertTitle" Text="SYSTEM ALERT" FontSize="20" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtAlertMessage" Text="Alert message here." FontSize="15" TextWrapping="Wrap" Margin="0,0,0,25" Opacity="0.8"/>

                    <Button Content="OK, GOT IT" Height="45" FontSize="16" FontWeight="Bold" 
                            Click="BtnCloseAlert_Click" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8" 
                            Background="#0D9488" BorderBrush="#0D9488" Foreground="White" HorizontalAlignment="Right" Width="130"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid x:Name="OverlayModal" Visibility="Collapsed" Grid.RowSpan="2" Background="#E60F172A" Panel.ZIndex="5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="200" Height="200" Margin="0,0,0,25">
                    <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" Maximum="100" Width="200" Height="200" Foreground="#14B8A6"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontSize="45" FontWeight="Black" Foreground="White"/>
                </Grid>
                <TextBlock x:Name="TxtModalMessage" Text="Scanning document..." FontSize="22" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>