<Window x:Class="AutoHealScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AutoHealScanner" Height="720" Width="1200" 
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="#2E3329"
        Background="#E2E5DE" 
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3E4F2B">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Direction="270"/>
            </Grid.Effect>
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCANNER" FontSize="26" FontWeight="Black" Foreground="#F4F5F0" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="20" Foreground="#A9B891" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="James Michael G. Biaton" TextWrapping="NoWrap" FontSize="16" FontWeight="Bold" Foreground="#E2E5DE" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#F0F2EB">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Direction="0"/>
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ACTIVE HARDWARE &amp; STATUS" FontWeight="Heavy" FontSize="13" Foreground="#3E4F2B" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#D4D7CF" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Select Device (Scanner &amp; Printer):" FontSize="11" Foreground="#6C7565" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="25" Height="25" Padding="0" Click="BtnRefreshHardware_Click" ToolTip="Refresh Device List">
                                    <materialDesign:PackIcon Kind="Refresh" Foreground="#4A6033" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="CmbActiveHardware" Foreground="#2E3329" Margin="0,0,0,10" FontSize="13" FontWeight="SemiBold" SelectionChanged="CmbActiveHardware_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Live Status:" FontSize="12" FontWeight="Bold" Foreground="#6C7565" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtPrinterStatus" Text="⚪ CHECKING..." FontSize="12" FontWeight="Black" Foreground="#4A6033" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnForceReconnect" Grid.Column="0" Content="RECONNECT" Background="#5B753F" BorderBrush="#5B753F" Foreground="#FAFAFA" Click="BtnForceReconnect_Click" Padding="0" FontSize="11" FontWeight="Bold"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Connect" FontSize="11" Foreground="#6C7565" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ToggleButton x:Name="ToggleAutoConnect" Checked="ToggleAutoConnect_Checked" Unchecked="ToggleAutoConnect_Unchecked"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SYSTEM AUDIT LOGS" FontWeight="Heavy" FontSize="13" Foreground="#3E4F2B" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#D4D7CF" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ListBox x:Name="ListAuditLogs" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="#4A5243">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,6"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" UniformCornerRadius="12" Background="#C2C6BD">
                        <Grid>
                            <TextBlock x:Name="TxtPreviewPlaceholder" Text="No document scanned or imported yet." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.5" Foreground="#3E4F2B" FontStyle="Italic" FontSize="16"/>
                            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="20" Visibility="Collapsed"/>
                            <WebBrowser x:Name="PdfViewer" Margin="20" Visibility="Collapsed"/>
                        </Grid>
                    </materialDesign:Card>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnImport" Grid.Column="0" Content="IMPORT" Height="60" FontSize="16" FontWeight="Black" Click="BtnImport_Click" Background="#7C8573" BorderBrush="#7C8573" Foreground="#FAFAFA"/>
                        <Button x:Name="BtnPrint" Grid.Column="2" Content="PRINT" Height="60" FontSize="16" FontWeight="Black" Click="BtnPrint_Click" Background="#3E4F2B" BorderBrush="#3E4F2B" Foreground="#FAFAFA"/>
                        <Button x:Name="BtnScan" Grid.Column="4" Content="SCAN" Height="60" FontSize="16" FontWeight="Black" Click="BtnScan_Click" Background="#5B753F" BorderBrush="#5B753F" Foreground="#FAFAFA"/>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" Background="#F0F2EB" BorderBrush="#D4D7CF" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="BATCH SCANS" FontWeight="Heavy" FontSize="14" Foreground="#3E4F2B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scanned pages compile here" FontSize="10" Foreground="#6C7565" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="ListBatchScans" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" SelectionChanged="ListBatchScans_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,15" HorizontalAlignment="Center">
                                        <Border BorderBrush="#C2C6BD" BorderThickness="2" CornerRadius="5" Background="#FFFFFF">
                                            <Image Source="{Binding Thumbnail}" Width="150" Height="200" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding PageLabel}" FontWeight="Bold" Foreground="#3E4F2B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <Button x:Name="BtnSavePdf" Content="SAVE AS PDF" Height="45" FontSize="13" FontWeight="Black" Click="BtnSavePdf_Click" Background="#4A6033" BorderBrush="#4A6033" Foreground="#FAFAFA" Margin="0,0,0,10"/>

                            <Button x:Name="BtnSavePhoto" Content="SAVE AS PHOTO" Height="45" FontSize="13" FontWeight="Black" Click="BtnSavePhoto_Click" Background="#5B753F" BorderBrush="#5B753F" Foreground="#FAFAFA" Margin="0,0,0,10"/>

                            <Button x:Name="BtnClearBatch" Content="CLEAR BATCH" Height="35" FontSize="12" FontWeight="Bold" Click="BtnClearBatch_Click" Background="Transparent" BorderBrush="#C9605F" Foreground="#C9605F"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PrintModal" Visibility="Collapsed" Grid.RowSpan="2" Background="#99000000" Panel.ZIndex="10">
            <materialDesign:Card HorizontalAlignment="Center" VerticalAlignment="Center" Width="880" MinHeight="550" UniformCornerRadius="15" Background="#F0F2EB">
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="PrinterSettings" Foreground="#4A6033" Width="30" Height="30" VerticalAlignment="Center"/>
                            <TextBlock Text="BROADCAST PRINT SETTINGS" FontSize="18" FontWeight="Black" Foreground="#3E4F2B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Select Output Printers:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                        <Border Background="#FAFAFA" BorderBrush="#D4D7CF" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,0,15" Height="100">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ListOutputPrinters">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="#2E3329" Margin="5,3" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paper Size:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbPaperSize" Foreground="#2E3329">
                                    <ComboBoxItem Content="Letter (8.5 x 11)"/>
                                    <ComboBoxItem Content="A4"/>
                                    <ComboBoxItem Content="Legal (8.5 x 14)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Orientation:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbOrientation" Foreground="#2E3329" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Portrait"/>
                                    <ComboBoxItem Content="Landscape"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="BtnToggleAdvanced" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#5B753F" HorizontalAlignment="Left" Margin="-10,0,0,10" Click="BtnToggleAdvanced_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Settings" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="ADVANCED SETTINGS" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="AdvancedSection" Visibility="Collapsed" Margin="0,0,0,15">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Images per Page (N-up):" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbLayout" Foreground="#2E3329">
                                        <ComboBoxItem Content="1-up (Standard)" IsSelected="True"/>
                                        <ComboBoxItem Content="2-up (Side by Side)"/>
                                        <ComboBoxItem Content="4-up (Grid Layout)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Auto-Maintenance Time:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtMaintTime" Text="07:00" Width="80" Foreground="#2E3329" ToolTip="Format HH:mm (24hr)"/>
                                        <TextBlock Text=" (24h)" VerticalAlignment="Center" FontSize="10" Foreground="#6C7565"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Extra Paper Sizes:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbPaperSizeAdvanced" Foreground="#2E3329">
                                        <ComboBoxItem Content="--- Select Extra ---" IsSelected="True"/>
                                        <ComboBoxItem Content="Statement (5.5 x 8.5)"/>
                                        <ComboBoxItem Content="Executive (7.25 x 10.5)"/>
                                        <ComboBoxItem Content="Folio (8.5 x 13)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Print Quality:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbPrintQuality" Foreground="#2E3329">
                                        <ComboBoxItem Content="Normal" IsSelected="True"/>
                                        <ComboBoxItem Content="Draft (Eco)"/>
                                        <ComboBoxItem Content="High (Best)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Color Mode:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbColorMode" Foreground="#2E3329" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Color"/>
                                    <ComboBoxItem Content="Grayscale"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Scaling:" FontWeight="Bold" Foreground="#4A5243" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbScaling" Foreground="#2E3329" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Fit to Page"/>
                                    <ComboBoxItem Content="Actual Size"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Copies per Printer:" FontWeight="Bold" Foreground="#4A5243" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="-" Width="40" Height="30" Click="BtnMinusCopy_Click" Background="#C2C6BD" BorderBrush="#C2C6BD" Foreground="#2E3329" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCopies" Text="1" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="15,0" Foreground="#2E3329"/>
                                <Button Content="+" Width="40" Height="30" Click="BtnPlusCopy_Click" Background="#C2C6BD" BorderBrush="#C2C6BD" Foreground="#2E3329" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="CANCEL" Height="45" FontWeight="Bold" Click="BtnCancelPrint_Click" Background="Transparent" BorderBrush="#C9605F" Foreground="#C9605F"/>
                            <Button Grid.Column="2" Content="CONFIRM" Height="45" FontWeight="Bold" Click="BtnConfirmPrint_Click" Background="#4A6033" BorderBrush="#4A6033" Foreground="#FAFAFA"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#C2C6BD" BorderBrush="#BFC3BA" BorderThickness="1" CornerRadius="10" Padding="15">
                        <Grid>
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="2">
                                <TextBlock Text="LIVE PREVIEW" FontSize="12" FontWeight="Bold" Foreground="#5C6653" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPdfPreviewMessage" Text="(Settings won't visually apply to PDF preview)" FontSize="10" FontStyle="Italic" Foreground="#3E4F2B" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="PaperPreviewBorder" Background="#FAFAFA" Width="260" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,25,0,0" Effect="{DynamicResource MaterialDesignShadowDepth2}">
                                <Grid>
                                    <Image x:Name="ImgPrintPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                                    <WebBrowser x:Name="PdfPrintPreview" Margin="0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <Grid x:Name="AlertModal" Visibility="Collapsed" Grid.RowSpan="2" Background="#CC000000" Panel.ZIndex="10">
            <materialDesign:Card HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" UniformCornerRadius="15" Background="#F0F2EB">
                <StackPanel Margin="30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="Alert" Foreground="#4A6033" Width="35" Height="35" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAlertTitle" Text="SYSTEM ALERT" FontSize="20" FontWeight="Black" Foreground="#3E4F2B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAlertMessage" Text="Alert message here." FontSize="15" Foreground="#2E3329" TextWrapping="Wrap" Margin="0,0,0,25" Opacity="0.9"/>
                    <Button Content="OK, GOT IT" Height="45" FontSize="16" FontWeight="Bold" Click="BtnCloseAlert_Click" Background="#4A6033" BorderBrush="#4A6033" Foreground="#FAFAFA" HorizontalAlignment="Right" Width="130"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid x:Name="OverlayModal" Visibility="Collapsed" Grid.RowSpan="2" Background="#E6E2E5DE" Panel.ZIndex="5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="200" Height="200" Margin="0,0,0,25">
                    <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" Maximum="100" Width="200" Height="200" Foreground="#4A6033"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="45" FontWeight="Black" Foreground="#3E4F2B"/>
                </Grid>
                <TextBlock x:Name="TxtModalMessage" Text="Scanning document..." FontSize="22" FontWeight="Bold" Foreground="#3E4F2B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>