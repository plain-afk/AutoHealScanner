<Window x:Class="AutoHealScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AutoHealScanner - Scanner Pro" Height="780" Width="1350" 
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        Background="{DynamicResource WindowBg}" 
        FontFamily="Segoe UI, Inter, Helvetica, Arial, sans-serif"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="{DynamicResource ColorWindowBg}"/>
        <SolidColorBrush x:Key="SidebarBg" Color="{DynamicResource ColorSidebarBg}"/>
        <SolidColorBrush x:Key="BatchBg" Color="{DynamicResource ColorBatchBg}"/>
        <SolidColorBrush x:Key="PreviewBg" Color="{DynamicResource ColorWindowBg}"/>
        <SolidColorBrush x:Key="RightPanelBg" Color="{DynamicResource ColorRightPanelBg}"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="TextGlow" Color="{DynamicResource ConsoleFg}"/>
        
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" AllowDrop="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide" MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="25"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="5" Stretch="Fill"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="false" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="4" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <SolidColorBrush x:Key="PrimaryAccent" Color="#3B82F6"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColNavSidebar" Width="220"/>
            <ColumnDefinition x:Name="ColBatchSidebar" Width="260"/>
            <ColumnDefinition x:Name="ColPreview" Width="*"/>
            <ColumnDefinition x:Name="ColRightPanel" Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0">
            <Grid x:Name="GridNavOuter" Margin="15,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PanelLogo" Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,30">
                    <Border x:Name="LogoIconBorder" Background="#06B6D4" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ShieldCheck" Foreground="{DynamicResource SidebarBg}" Width="20" Height="20"/>
                    </Border>
                    <StackPanel x:Name="LogoTextPanel">
                        <TextBlock x:Name="LogoText1" Text="NEXUS SCAN" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="LogoText2" Text="Auto-Heal Engine" FontSize="9" FontWeight="Bold" Foreground="#06B6D4" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Border x:Name="NavDashboard" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavDashboard_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelDashboard" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconDashboard" Kind="ViewDashboard" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelDashboard" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavScanCenter" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavScanCenter_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelScanCenter" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconScanCenter" Kind="Scanner" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelScanCenter" Text="Scan Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavBatchPages" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavBatchPages_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelBatchPages" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconBatchPages" Kind="FolderMultiple" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelBatchPages" Text="Batch Pages" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavLibrary" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavLibrary_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelLibrary" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconLibrary" Kind="Library" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelLibrary" Text="Library" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavPdfReader" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavPdfReader_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelPdfReader" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconPdfReader" Kind="FilePdfBox" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelPdfReader" Text="PDF Reader" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavConverter" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavConverter_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelConverter" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconConverter" Kind="SwapHorizontal" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelConverter" Text="Convert to PDF" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavPrinterCenter" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavPrinterCenter_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelPrinterCenter" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconPrinterCenter" Kind="PrinterSettings" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelPrinterCenter" Text="Printer Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavAutomations" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="NavAutomations_MouseDown" Cursor="Hand">
                        <StackPanel x:Name="PanelAutomations" Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconAutomations" Kind="Robot" Foreground="{DynamicResource TextDim}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LabelAutomations" Text="Automations" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelUser" Grid.Row="2" Margin="5,0,0,0">
                    <Border x:Name="BtnToggleTheme" Background="Transparent" CornerRadius="8" Padding="10" Margin="0,0,0,10" MouseDown="BtnToggleTheme_MouseDown" Cursor="Hand" MouseEnter="ThemeBtn_MouseEnter" MouseLeave="ThemeBtn_MouseLeave">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon x:Name="IconTheme" Kind="WeatherNight" Foreground="{DynamicResource TextMuted}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtThemeMode" Text="Dark Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="UserBorder" Background="{DynamicResource ProfileBg}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" MouseDown="NavProfile_MouseDown" Cursor="Hand" MouseEnter="UserBorder_MouseEnter" MouseLeave="UserBorder_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0">
                                <Border CornerRadius="15" Width="30" Height="30" Background="{DynamicResource AvatarBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProfileInitials" Text="JB" Foreground="{DynamicResource AvatarText}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="10" Height="10" Background="#10B981" CornerRadius="5" BorderBrush="{DynamicResource ProfileBg}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                            </Grid>

                            <StackPanel x:Name="UserInfoPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProfileName" Text="James Michael G. Biaton II" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="Cog" Foreground="{DynamicResource TextDim}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BorderBatchSidebar" Grid.Column="1" Background="{StaticResource BatchBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0">
            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="BATCH PAGES" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <Border Background="{DynamicResource NavActiveBg}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Pages compile here" FontSize="9" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <ListBox x:Name="ListBatchScans" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListBatchScans_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="4">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" CornerRadius="8" Padding="10" Width="210" Height="270" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0" Background="{DynamicResource DeepBg}" CornerRadius="4" Padding="5" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Margin="0,0,0,10">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PageLabel}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Processed" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button x:Name="BtnSavePdf" Content="Export PDF" Height="40" FontSize="12" FontWeight="Black" Click="BtnSavePdf_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                    <Button x:Name="BtnSavePhoto" Content="Export Image" Height="40" FontSize="12" FontWeight="Black" Click="BtnSavePhoto_Click" Background="{DynamicResource TextDarker}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                    <Button x:Name="BtnClearBatch" Content="Clear Batch" Height="30" FontSize="11" FontWeight="Bold" Click="BtnClearBatch_Click" Background="Transparent" BorderBrush="#F43F5E" BorderThickness="1" Foreground="#F43F5E"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="GridPreviewArea" Grid.Column="2" Background="{StaticResource PreviewBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,0,1" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnToggleBatch" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Margin="0,0,12,0" Click="BtnToggleBatch_Click" ToolTip="Toggle Batch Panel">
                            <materialDesign:PackIcon x:Name="IconToggleBatch" Kind="Menu" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                        </Button>
                        <TextBlock Text="DOCUMENT PREVIEW" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource InputBg}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Live Image Renderer" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnImport" Content="Import File" Height="34" Padding="12,0" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnImport_Click" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <Button x:Name="BtnPrint" Content="Print Batch" Height="34" Padding="12,0" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnPrint_Click" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        
                        <Button x:Name="BtnScan" Content="Scan New" Height="34" Padding="15,0" Background="{StaticResource AccentGreen}" BorderBrush="Transparent" Foreground="{DynamicResource SidebarBg}" Click="BtnScan_Click" FontSize="11" FontWeight="Black" Margin="0,0,10,0">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#10B981" Opacity="0.3" ShadowDepth="0"/>
                            </Button.Effect>
                        </Button>

                        <Button x:Name="BtnToggleRightPanel" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnToggleRightPanel_Click" ToolTip="Toggle System Control Panel">
                            <materialDesign:PackIcon x:Name="IconToggleRightPanel" Kind="Settings" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource DeepBg}" Margin="15" CornerRadius="12" BorderBrush="{DynamicResource InputBg}" BorderThickness="1">
                <Grid>
                    <Border Width="300" Height="300" Background="#06B6D4" Opacity="0.02" CornerRadius="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <BlurEffect Radius="80"/>
                        </Border.Effect>
                    </Border>
                    
                    <StackPanel x:Name="TxtPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="60" Height="60" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No document loaded" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Click Scan New or Import File to render" HorizontalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border x:Name="ImgBorderFrame" Margin="25" BorderBrush="#06B6D4" BorderThickness="0" CornerRadius="4">
                        <Grid>
                            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                            <WebBrowser x:Name="PdfViewer" Margin="10" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,1,0,0" Padding="15,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Zoom In">
                        <materialDesign:PackIcon Kind="ZoomIn" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Zoom Out">
                        <materialDesign:PackIcon Kind="ZoomOut" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Rotate Left">
                        <materialDesign:PackIcon Kind="RotateLeft" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Rotate Right">
                        <materialDesign:PackIcon Kind="RotateRight" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Contrast Adjust">
                        <materialDesign:PackIcon Kind="Contrast" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" Margin="10,0" ToolTip="Crop Frame">
                        <materialDesign:PackIcon Kind="Crop" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="BorderRightPanel" Grid.Column="3" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1,0,0,0">
            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,15" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SYSTEM CONTROL" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Diagnostics and Auto-Heal" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NavActiveBg}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" Background="#10B981" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Router" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="DEVICE CONTROLLER" FontWeight="Heavy" FontSize="11" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Active Hardware:" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="25" Height="25" Padding="0" Click="BtnRefreshHardware_Click" ToolTip="Refresh Device List">
                                <materialDesign:PackIcon Kind="Refresh" Foreground="#06B6D4" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <ComboBox x:Name="CmbActiveHardware" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" SelectionChanged="CmbActiveHardware_SelectionChanged"/>

                        <Grid Margin="0,4,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hardware Status:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrinterStatus" Grid.Column="1" Text="⚪ CHECKING..." FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnForceReconnect" Grid.Column="0" Content="HEAL SERVICE" Height="34" Background="{StaticResource PrimaryAccent}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnForceReconnect_Click" FontSize="10.5" FontWeight="Black"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Auto-Heal" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ToggleButton x:Name="ToggleAutoConnect" IsChecked="True" Checked="ToggleAutoConnect_Checked" Unchecked="ToggleAutoConnect_Unchecked" Cursor="Hand" Width="35" Height="18"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,8">
                            <materialDesign:PackIcon Kind="Console" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="AUDIT LOGS &amp; ACTIONS" FontWeight="Heavy" FontSize="11" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" Background="{DynamicResource DeepestBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ListBox x:Name="ListAuditLogs" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas, Monaco, Courier New, monospace">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10.5" Margin="0,3.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ViewScanCenter" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColScanLeft" Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColScanRight" Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="SCANNER PROFILE" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Configure capture parameters" FontSize="9.5" Foreground="#06B6D4" Margin="0,2,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Resolution (DPI)" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbDpi" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,15">
                                <ComboBoxItem Content="75 DPI (Draft)" />
                                <ComboBoxItem Content="150 DPI (Standard)" />
                                <ComboBoxItem Content="300 DPI (High Quality)" IsSelected="True"/>
                                <ComboBoxItem Content="600 DPI (Archival)"/>
                            </ComboBox>

                            <TextBlock Text="Color Mode" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbScanColorMode" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,15">
                                <ComboBoxItem Content="Full Color" IsSelected="True"/>
                                <ComboBoxItem Content="Grayscale"/>
                                <ComboBoxItem Content="Black &amp; White"/>
                            </ComboBox>

                            <TextBlock Text="Document Source" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbSource" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,15" SelectionChanged="CmbSource_SelectionChanged">
                                <ComboBoxItem Content="Flatbed Glass" IsSelected="True"/>
                                <ComboBoxItem Content="ADF (Simplex)"/>
                                <ComboBoxItem Content="ADF (Duplex)"/>
                            </ComboBox>

                            <TextBlock Text="Scan Area Size" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbScanSize" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,15">
                                <ComboBoxItem Content="Letter (8.5 x 11 in)" IsSelected="True"/>
                                <ComboBoxItem Content="A4 (210 x 297 mm)"/>
                                <ComboBoxItem Content="Legal (8.5 x 14 in)"/>
                            </ComboBox>

                            <TextBlock Text="Default File Format" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbFormat" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,20">
                                <ComboBoxItem Content="PDF Document (*.pdf)" IsSelected="True"/>
                                <ComboBoxItem Content="JPEG Image (*.jpg)"/>
                                <ComboBoxItem Content="PNG Image (*.png)"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Contrast" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderContrast}" Foreground="#06B6D4" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Brightness" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderBrightness}" Foreground="#06B6D4" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,20"/>

                            <Separator Background="{DynamicResource InputBg}" Margin="0,5,0,15"/>

                            <CheckBox x:Name="ChkAutoCrop" Content="Auto-Crop Page Borders" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="ChkAutoDeskew" Content="Auto-Deskew &amp; Align" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="ChkBlankPageRemoval" Content="Blank Page Removal" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PreviewBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Border Width="8" Height="8" Background="#10B981" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="HARDWARE ENGINE ACTIVE" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="20" Background="{DynamicResource DeepBg}" BorderBrush="{DynamicResource InputBg}">
                    <Grid>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" BorderBrush="#06B6D4" BorderThickness="2" CornerRadius="12" Width="280" Height="360" Background="{DynamicResource DarkerBg}" Padding="15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Color="#06B6D4" Opacity="0.1" ShadowDepth="0"/>
                                </Border.Effect>
                                <Grid>
                                    <Border Background="{DynamicResource ItemHoverBg}" CornerRadius="8" BorderBrush="{DynamicResource InputBg}" BorderThickness="1">
                                        <Grid>
                                            <Border x:Name="DocSheetMock" Background="{DynamicResource TextPrimary}" Width="180" Height="240" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.8" Padding="15">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="FileDocument" Foreground="{DynamicResource NavActiveBorder}" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                    <Border Height="6" Background="#CBD5E1" CornerRadius="3" Margin="0,0,0,6"/>
                                                    <Border Height="6" Background="#CBD5E1" CornerRadius="3" Margin="0,0,0,6"/>
                                                    <Border Height="6" Background="#E2E8F0" CornerRadius="3" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="LaserBar" Height="4" Background="#00FFC4" VerticalAlignment="Top" BorderThickness="0">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="15" Color="#00FFC4" Opacity="0.9" ShadowDepth="0"/>
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Text="Place document face down on the glass bed" FontSize="11" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,15,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <Button x:Name="BtnScanCenterTrigger" Content="INITIATE CAPTURE SEQUENCE" Height="50" FontSize="13" FontWeight="Black" Background="{StaticResource AccentGreen}" BorderBrush="Transparent" Foreground="{DynamicResource SidebarBg}" Click="BtnScan_Click" Width="380">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#10B981" Opacity="0.3" ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="BorderScanRight" Grid.Column="2" Background="{StaticResource SidebarBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="AUTO-HEAL HUB" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Real-time scanning health" FontSize="9.5" Foreground="#06B6D4" Margin="0,2,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="DRIVER INTEGRITY" FontWeight="Black" FontSize="10.5" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WIA Service Status:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Running" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="USB Plug-and-Play:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Connected" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Device Comm Link:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Optimal" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Router" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="DEVICE CONTROLLER &amp; CAPABILITIES" FontWeight="Heavy" FontSize="11" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Select Scanner Device:" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbScanDevice" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,12" SelectionChanged="CmbScanDevice_SelectionChanged"/>

                                <Border Background="{DynamicResource CardBgAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon x:Name="IconScanFeeder" Kind="FileDocument" Foreground="#06B6D4" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="INSTRUCTIONS FOR PAPER PLACEMENT:" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtScanFeederInstruction" Text="Place paper face down on the glass bed under the lid." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="HARDWARE SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max Optical Resolution:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="600 x 600 DPI" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Color Scan Modes:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Color, Grayscale, Monochrome" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ADF Tray Feeder:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Supported (Simplex)" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duplex (Double-sided):" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Via ADF Feeder Only" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnScanDoctor" Content="RUN SCAN DIAGNOSTICS DOCTOR" Height="40" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Black" Click="BtnForceReconnect_Click" Margin="0,0,0,20"/>

                        <TextBlock Text="SCANNER ENGINE LOGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource DeepestBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="10" Height="220">
                            <ListBox x:Name="ListScanCenterLogs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas, monospace">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10" Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewLibrary" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLibLeft" Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColLibRight" Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="LIBRARY SYSTEM" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Repository folders &amp; stats" FontSize="9.5" Foreground="#06B6D4" Margin="0,2,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE REPOSITORY" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtLibraryPath" Text="C:\ScannedDocuments" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button x:Name="BtnBrowseLibrary" Content="Change Folder" Height="32" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnBrowseLibrary_Click" FontSize="10.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="QUICK CATEGORIES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,8"/>
                            
                            <Border x:Name="TagAllFiles" Background="{DynamicResource NavActiveBg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="TagAllFiles_MouseDown" Cursor="Hand" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <materialDesign:PackIcon Kind="FolderMultipleOutline" Foreground="#06B6D4" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LabelTagAll" Text="All Document Files" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountAll" Text="0" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <Border x:Name="TagPdfFiles" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" MouseDown="TagPdfFiles_MouseDown" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <materialDesign:PackIcon x:Name="IconTagPdf" Kind="FilePdfBox" Foreground="{DynamicResource TextDim}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LabelTagPdf" Text="PDF Documents" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountPdf" Text="0" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <Border x:Name="TagImgFiles" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,15" MouseDown="TagImgFiles_MouseDown" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <materialDesign:PackIcon x:Name="IconTagImg" Kind="FileImage" Foreground="{DynamicResource TextDim}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LabelTagImg" Text="Image Scans (JPG/PNG)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountImg" Text="0" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="LIBRARY UTILIZATION" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Size on Disk:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtLibraryDiskSize" Text="0.00 MB" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Avg File Size:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtLibraryAvgSize" Text="0.00 KB" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PreviewBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,0,1" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,15,0" MaxWidth="350" HorizontalAlignment="Left">
                            <TextBox x:Name="TxtLibrarySearch" Width="300" Background="{DynamicResource BatchBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Padding="35,6,12,6" FontSize="12" Margin="0" TextChanged="TxtLibrarySearch_TextChanged" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="Search" Foreground="{DynamicResource TextDim}" Width="16" Height="16" VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbLibraryFormat" Width="130" Margin="0,0,10,0" Style="{StaticResource DarkComboBox}" FontSize="11.5" SelectionChanged="CmbLibraryFormat_SelectionChanged">
                                <ComboBoxItem Content="All Formats" IsSelected="True"/>
                                <ComboBoxItem Content="PDF Files (*.pdf)"/>
                                <ComboBoxItem Content="JPEG Files (*.jpg)"/>
                                <ComboBoxItem Content="PNG Files (*.png)"/>
                            </ComboBox>

                            <ComboBox x:Name="CmbLibrarySort" Width="180" Margin="0,0,10,0" Style="{StaticResource DarkComboBox}" FontSize="11.5" SelectionChanged="CmbLibrarySort_SelectionChanged">
                                <ComboBoxItem Content="Date Modified (Newest)" IsSelected="True"/>
                                <ComboBoxItem Content="Date Modified (Oldest)"/>
                                <ComboBoxItem Content="Name (A to Z)"/>
                                <ComboBoxItem Content="Name (Z to A)"/>
                                <ComboBoxItem Content="Size (Largest First)"/>
                                <ComboBoxItem Content="Size (Smallest First)"/>
                            </ComboBox>

                            <Button x:Name="BtnRefreshLibrary" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnRefreshLibrary_Click" ToolTip="Refresh Files">
                                <materialDesign:PackIcon Kind="Refresh" Foreground="#06B6D4" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15">
                    <Grid>
                        <StackPanel x:Name="TxtLibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0" Visibility="Collapsed" Opacity="0.5">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="55" Height="55" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No documents found" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Scanned documents or files matching filters will appear here" HorizontalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="ListLibraryFiles" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListLibraryFiles_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" CornerRadius="8" Padding="8" Width="145" Height="205" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="125"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource DeepBg}" CornerRadius="5" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,6">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#EF4444" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                            <Condition Binding="{Binding IsPdf}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Kind="FileImage" Foreground="#06B6D4" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                            <Condition Binding="{Binding IsPdf}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileSize}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                                                        <Setter Property="Background" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPdf}" Value="False">
                                                                        <Setter Property="Background" Value="#06B6D4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="8" FontWeight="Black" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="IMG"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SidebarBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                                                            <Setter Property="Text" Value="PDF"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border x:Name="BorderLibRight" Grid.Column="2" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                    <StackPanel x:Name="TxtLibraryDetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" Margin="0">
                        <materialDesign:PackIcon Kind="FileSearchOutline" Width="50" Height="50" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No item selected" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Select a document file to manage" HorizontalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid x:Name="GridLibraryDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DOCUMENT DETAILS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Inspect and perform actions" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Height="190" Background="{DynamicResource DeepBg}" CornerRadius="8" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" Margin="0,0,0,15" ClipToBounds="True">
                            <Grid>
                                <Border Width="120" Height="120" Background="#06B6D4" Opacity="0.04" CornerRadius="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <BlurEffect Radius="30"/>
                                    </Border.Effect>
                                </Border>
                                <Image x:Name="ImgLibraryDetailPreview" Stretch="Uniform" Margin="5"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel>
                                <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="FILE METADATA" FontWeight="Black" FontSize="9.5" Foreground="#06B6D4" Margin="0,0,0,8"/>
                                        
                                        <TextBlock Text="File Name:" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtLibDetailName" Text="Scan_Example.pdf" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <TextBlock Text="File Location:" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtLibDetailPath" Text="C:\ScannedDocuments\Scan_Example.pdf" FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="File Size:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtLibDetailSize" Text="1.24 MB" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Date Modified:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtLibDetailDate" Text="2026-05-26 10:14" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Button x:Name="BtnLibOpen" Content="OPEN DOCUMENT" Height="38" FontSize="11" FontWeight="Black" Background="{StaticResource AccentCyan}" BorderBrush="Transparent" Foreground="{DynamicResource SidebarBg}" Click="BtnLibOpen_Click" Margin="0,0,0,8">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="#06B6D4" Opacity="0.2" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="BtnLibReadPdf" Content="READ PDF IN APP" Height="38" FontSize="11" FontWeight="Black" Background="#EF4444" BorderBrush="Transparent" Foreground="#FFFFFF" Click="BtnLibReadPdf_Click" Margin="0,0,0,8" Visibility="Collapsed">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="#EF4444" Opacity="0.2" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>
                            
                            <Button x:Name="BtnLibPrint" Content="PRINT COCKPIT" Height="38" FontSize="11" FontWeight="Black" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnLibPrint_Click" Margin="0,0,0,8"/>

                            <Button x:Name="BtnLibAddToBatch" Content="COMPILE TO BATCH" Height="36" FontSize="11" FontWeight="Bold" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnLibAddToBatch_Click" Margin="0,0,0,10"/>

                            <Button x:Name="BtnLibDelete" Content="DELETE FROM DISK" Height="34" FontSize="10.5" FontWeight="Bold" Background="Transparent" BorderBrush="#EF4444" BorderThickness="1.5" Foreground="#EF4444" Click="BtnLibDelete_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewAutomations" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColAutoLeft" Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColAutoRight" Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="AUTOMATION RULES" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Set conditions and background tasks" FontSize="9.5" Foreground="#06B6D4" Margin="0,2,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="SERVICE HEALTH WATCHDOG" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                    
                                    <CheckBox x:Name="ChkWatchdogEnabled" Content="Enable Health Watchdog" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" IsChecked="True" Checked="ChkWatchdogEnabled_Changed" Unchecked="ChkWatchdogEnabled_Changed" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="Diagnostics Interval:" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbWatchdogInterval" Style="{StaticResource DarkComboBox}" FontSize="12" SelectionChanged="CmbWatchdogInterval_SelectionChanged" Margin="0,0,0,15">
                                        <ComboBoxItem Content="Every 30 seconds"/>
                                        <ComboBoxItem Content="Every 1 minute" IsSelected="True"/>
                                        <ComboBoxItem Content="Every 5 minutes"/>
                                        <ComboBoxItem Content="Every 15 minutes"/>
                                        <ComboBoxItem Content="Every 1 hour"/>
                                    </ComboBox>

                                    <TextBlock Text="Auto-Heal Active Targets:" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkHealSpooler" Content="Print Spooler Service" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkHealWia" Content="Windows Image (WIA) Service" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" IsChecked="True" Margin="0,0,0,5"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="POST-SCAN WORKFLOWS" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                    
                                    <CheckBox x:Name="ChkAutoBackup" Content="Auto-Backup Scanned Files" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" IsChecked="False" Checked="ChkAutoBackup_Changed" Unchecked="ChkAutoBackup_Changed" Margin="0,0,0,12"/>
                                    
                                    <CheckBox x:Name="ChkAutoPrint" Content="Auto-Print on Scan Complete" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" IsChecked="False" Checked="ChkAutoPrint_Changed" Unchecked="ChkAutoPrint_Changed" Margin="0,0,0,5"/>
                                    <TextBlock Text="(Prints copies automatically using Print Cockpit selections)" FontSize="9.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PreviewBg}" Padding="20">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="ACTIVE AUTOMATION ENGINE" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Real-time parameters and synchronization status" FontSize="9.5" Foreground="#06B6D4" Margin="0,2,0,0" FontWeight="Bold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <TextBlock Text="BACKUP STORAGE DESTINATION" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                <TextBlock Text="Scanned files will replicate here instantly upon capture:" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                
                                <Border Background="{DynamicResource BatchBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtBackupPath" Text="C:\ScannedDocuments\Backup" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" TextWrapping="Wrap"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnBrowseBackup" Grid.Column="0" Content="Select Backup Folder" Height="34" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnBrowseBackup_Click" FontSize="11" FontWeight="Bold"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FolderSync" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBackupFilesCount" Text="0 files replicated" FontSize="11.5" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <TextBlock Text="PRINT QUEUE OVERWATCH" FontWeight="Black" FontSize="10" Foreground="#06B6D4" Margin="0,0,0,10"/>
                                <TextBlock Text="Monitor system for jammed print files. Stuck print queue documents cause hardware hangs. The Spooler Cleaner stops services, deletes files from the Windows Spool directory, and heals it." FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#EF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="System Purge Action" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Target Path: C:\Windows\System32\spool\PRINTERS\" FontSize="10.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}" Padding="20" Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource InputBg}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Background="{DynamicResource PopupBg}" BorderBrush="#06B6D4" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Autorenew" Foreground="#06B6D4" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SCHEDULER SERVICE STATUS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextDim}" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtAutomationStatus" Text="STANDBY (Waiting for check cycle...)" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource ConsoleFg}"/>
                                    <TextBlock Text="Watchdog timer updates automatically based on selected interval." FontSize="10" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

            <Border x:Name="BorderAutoRight" Grid.Column="2" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,15" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MANUAL TRIGGER BOARD" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Test automation parameters immediately" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <Button x:Name="BtnTestWatchdog" Content="FORCE WATCHDOG CYCLE" Height="38" FontSize="11" FontWeight="Black" Background="{StaticResource AccentCyan}" BorderBrush="Transparent" Foreground="{DynamicResource SidebarBg}" Click="BtnTestWatchdog_Click" Margin="0,0,0,8">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#06B6D4" Opacity="0.2" ShadowDepth="0"/>
                            </Button.Effect>
                        </Button>

                        <Button x:Name="BtnTestBackup" Content="SYNC BACKUP DIRECTORY" Height="38" FontSize="11" FontWeight="Black" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnTestBackup_Click" Margin="0,0,0,8"/>

                        <Button x:Name="BtnPurgeSpooler" Content="PURGE STUCK SPOOLER QUEUE" Height="36" FontSize="10.5" FontWeight="Bold" Background="Transparent" BorderBrush="#EF4444" BorderThickness="1.5" Foreground="#EF4444" Click="BtnPurgeSpooler_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,8">
                            <materialDesign:PackIcon Kind="ConsoleLine" Foreground="#06B6D4" Width="16" Height="16" VerticalAlignment="Center"/>
