                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource DeepestBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ListBox x:Name="ListAutomationLogs" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas, monospace">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10.5" Margin="0,2.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewDashboard" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed" Margin="35,20,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NEXUS SCAN CONTROL COCKPIT" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Admin Console" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource InputBg}" Margin="8,0"/>
                        <TextBlock x:Name="TxtDashClock" Text="Live Monitoring Mode" FontSize="11" Foreground="#06B6D4" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" CornerRadius="8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="DashStatusSignal" Width="8" Height="8" Background="#10B981" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="TxtDashStatus" Text="BIATON SYSTEM ONLINE" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL SCAN VOLUME" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtDashTotalFiles" Text="0 files" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            <TextBlock Text="Local storage matches" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NavActiveBg}" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderMultiple" Foreground="#06B6D4" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STORAGE FOOTPRINT" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtDashDiskSize" Text="0.00 MB" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            <TextBlock Text="Total repository size" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NavActiveBg}" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Database" Foreground="#3B82F6" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DETECTED HARDWARE" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtDashHardwareCount" Text="0 devices" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            <TextBlock Text="Printers and scanners" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NavActiveBg}" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Printer" Foreground="#10B981" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WATCHDOG RECOVERIES" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtDashHealCount" Text="0 cycles" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            <TextBlock Text="Service recovery triggers" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NavActiveBg}" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldCheck" Foreground="#EF4444" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition x:Name="ColDashRight" Width="380"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Card 1: Service Diagnostics -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <materialDesign:PackIcon Kind="HeartPulse" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="SERVICE INTEGRITY DIAGNOSTICS" FontWeight="Black" FontSize="11.5" Foreground="#06B6D4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <!-- Spooler status meter -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Background="{DynamicResource BatchBg}" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="PRINT SPOOLER DRIVER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Windows Spooler service status" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <ProgressBar x:Name="BarDashSpooler" Grid.Column="1" Value="100" Height="6" Background="{DynamicResource NavActiveBg}" Foreground="#10B981" Margin="25,0" VerticalAlignment="Center"/>

                                            <Border x:Name="BadgeDashSpooler" Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDashSpoolerStatus" Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- WIA status meter -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Background="{DynamicResource BatchBg}" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="SCANNER WIA DRIVER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Windows Image Acquisition status" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <ProgressBar x:Name="BarDashWia" Grid.Column="1" Value="100" Height="6" Background="{DynamicResource NavActiveBg}" Foreground="#10B981" Margin="25,0" VerticalAlignment="Center"/>

                                            <Border x:Name="BadgeDashWia" Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDashWiaStatus" Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Storage status meter -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,0" Background="{DynamicResource BatchBg}" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="STORAGE REPOSITORY LINK" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Active Directory Link status" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <ProgressBar x:Name="BarDashDisk" Grid.Column="1" Value="100" Height="6" Background="{DynamicResource NavActiveBg}" Foreground="#10B981" Margin="25,0" VerticalAlignment="Center"/>

                                            <Border x:Name="BadgeDashDisk" Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDashDiskStatus" Text="HEALTHY" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,15,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Auto-Heal Engine Core is Active" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Click to run manual diagnostic and fix sequence" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,1.5,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnDashHeal" Grid.Column="1" Content="RUN SELF-REPAIR NOW" Height="32" Padding="12,0" Background="{StaticResource PrimaryAccent}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnForceReconnect_Click" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 2: Consumables & Queue Dashboard -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <materialDesign:PackIcon Kind="Printer" Foreground="#3B82F6" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="DEFAULT PRINTER CONSUMABLES" FontWeight="Black" FontSize="11.5" Foreground="#3B82F6" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDashPrinterModel" Text="Detecting..." FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtDashPrinterInkStatus" Grid.Column="1" Text="✓ LEVELS OK" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Cyan -->
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="Cyan" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtDashTonerCyan" Text="100%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarDashTonerCyan" Height="5" Minimum="0" Maximum="100" Value="100" Foreground="#06B6D4" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Magenta -->
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="Mag" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtDashTonerMagenta" Text="100%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarDashTonerMagenta" Height="5" Minimum="0" Maximum="100" Value="100" Foreground="#EC4899" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Yellow -->
                                    <StackPanel Grid.Column="4">
                                        <Grid>
                                            <TextBlock Text="Yel" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtDashTonerYellow" Text="100%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarDashTonerYellow" Height="5" Minimum="0" Maximum="100" Value="100" Foreground="#EAB308" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Black -->
                                    <StackPanel Grid.Column="6">
                                        <Grid>
                                            <TextBlock Text="Black" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtDashTonerBlack" Text="100%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarDashTonerBlack" Height="5" Minimum="0" Maximum="100" Value="100" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Separator Background="{DynamicResource InputBg}" Margin="0,15,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Active Print Jobs Queue" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtDashQueueSummary" Text="0 jobs currently pending execution" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnDashOpenPrinterCenter" Grid.Column="1" Content="GO TO COCKPIT" Height="28" Padding="10,0" Background="Transparent" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" Foreground="{DynamicResource TextPrimary}" Click="BtnDashOpenPrinterCenter_Click" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Watchdog & Automations Status -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,0" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Robot" Foreground="#10B981" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="SYSTEM AUTOMATIONS &amp; WATCHDOG" FontWeight="Black" FontSize="11.5" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Watchdog Status" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtDashWatchdogEnabled" Text="ENABLED" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Backup Repl" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtDashReplicationCount" Text="0 files backed up" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="BorderDashRight" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="History" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="RECENT SCANNED DOCUMENTS" FontWeight="Black" FontSize="11.5" Foreground="#06B6D4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="ListDashRecentFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListDashRecentFiles_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" CornerRadius="8" Padding="10" Width="330" Height="76" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="40" Height="50" Background="{DynamicResource DeepBg}" CornerRadius="4" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#EF4444" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Kind="FileImage" Foreground="#06B6D4" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPdf}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSize}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding DisplayDate}" FontSize="8.5" Foreground="{DynamicResource TextDim}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30" Padding="0" Click="BtnDashOpen_Click" ToolTip="Open Document">
                                                    <materialDesign:PackIcon Kind="OpenInNew" Foreground="#06B6D4" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30" Padding="0" Click="BtnDashPrint_Click" ToolTip="Print Document">
                                                    <materialDesign:PackIcon Kind="Printer" Foreground="#3B82F6" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ViewPdfReader" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColPdfLeft" Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColPdfRight" Width="320"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BorderPdfLeft" Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="15,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="PDF PAGES" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="{DynamicResource NavActiveBg}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtPdfReaderPageCountLabel" Text="No PDF loaded" FontSize="9.5" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="ListPdfReaderThumbnails" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListPdfReaderThumbnails_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6" Width="200" Height="170" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{DynamicResource DeepBg}" CornerRadius="4" Padding="3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,5">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding PageLabel}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PreviewBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,0,1" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPdfReaderOpen" Content="Open PDF File" Height="34" Padding="15,0" Background="{StaticResource PrimaryAccent}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnPdfReaderOpen_Click" FontSize="11" FontWeight="Black" Margin="0,0,15,0"/>
                            <TextBlock x:Name="TxtPdfReaderFileNameHeader" Text="No file opened" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPdfReaderClose" ToolTip="Close PDF" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderClose_Click" Margin="10,0,0,0">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#EF4444" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnPdfReaderPrev" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderPrev_Click" ToolTip="Previous Page">
                                <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                            </Button>
                            <TextBlock x:Name="TxtPdfReaderPageIndicator" Text="Page 0 of 0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="10,0" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPdfReaderNext" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderNext_Click" ToolTip="Next Page">
                                <materialDesign:PackIcon Kind="ArrowRight" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPdfReaderZoomOut" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderZoomOut_Click" ToolTip="Zoom Out">
                                <materialDesign:PackIcon Kind="ZoomOut" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                            </Button>
                            <TextBlock x:Name="TxtPdfReaderZoomLabel" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPdfReaderZoomIn" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderZoomIn_Click" ToolTip="Zoom In">
                                <materialDesign:PackIcon Kind="ZoomIn" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                            </Button>
                            <Button x:Name="BtnPdfReaderZoomFit" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnPdfReaderZoomFit_Click" ToolTip="Fit to Page">
                                <materialDesign:PackIcon Kind="Fullscreen" Foreground="{DynamicResource TextMuted}" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource DeepBg}" Margin="15" CornerRadius="12" BorderBrush="{DynamicResource InputBg}" BorderThickness="1">
                    <Grid>
                        <StackPanel x:Name="PanelPdfReaderPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="60" Height="60" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="PDF Reader Standby" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Click Open PDF File to load and read documents" HorizontalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer x:Name="ScrollPdfPage" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="10">
                            <Border x:Name="BorderPdfPageDisplay" Background="White" BorderThickness="1" BorderBrush="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.4" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="ImgPdfPageDisplay" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="BorderPdfRight" Grid.Column="2" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1,0,0,0" Padding="15,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,15" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PAGE OPERATIONS" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Extract, rotate &amp; print" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="DOCUMENT DETAILS" FontWeight="Heavy" FontSize="11" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Filename:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPdfReaderDetailName" Text="N/A" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pages:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPdfReaderDetailPageCount" Text="0 pages" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File Size:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPdfReaderDetailSize" Text="0.00 KB" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Full Path:" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPdfReaderDetailPath" Text="N/A" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <materialDesign:PackIcon Kind="Tune" Foreground="#06B6D4" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIONS &amp; WORKFLOWS" FontWeight="Heavy" FontSize="11" Foreground="#06B6D4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnPdfReaderAddToBatch" Content="Add Page to Batch" Height="36" FontSize="11.5" FontWeight="Black" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnPdfReaderAddToBatch_Click" Margin="0,0,0,10" IsEnabled="False"/>

                            <Button x:Name="BtnPdfReaderPrintPage" Content="Print Current Page" Height="36" FontSize="11.5" FontWeight="Black" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnPdfReaderPrintPage_Click" Margin="0,0,0,10" IsEnabled="False"/>

                            <Button x:Name="BtnPdfReaderExportImage" Content="Export Page as JPEG" Height="36" FontSize="11.5" FontWeight="Black" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnPdfReaderExportImage_Click" Margin="0,0,0,15" IsEnabled="False"/>

                            <Separator Margin="0,0,0,15" Background="{DynamicResource InputBg}"/>

                            <TextBlock Text="Page Rotation:" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPdfReaderRotateLeft" Grid.Column="0" Content="Rotate Left" Height="34" FontSize="11" FontWeight="SemiBold" Click="BtnPdfReaderRotateLeft_Click" Background="Transparent" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" IsEnabled="False"/>
                                <Button x:Name="BtnPdfReaderRotateRight" Grid.Column="2" Content="Rotate Right" Height="34" FontSize="11" FontWeight="SemiBold" Click="BtnPdfReaderRotateRight_Click" Background="Transparent" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewPlaceholder" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource NavActiveBg}" CornerRadius="12" Padding="25" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" MaxWidth="500">
                    <StackPanel>
                        <materialDesign:PackIcon x:Name="IconPlaceholderTab" Kind="Database" Width="50" Height="50" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock x:Name="TxtPlaceholderTitle" Text="DASHBOARD" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtPlaceholderDesc" Text="Detailed monitoring widgets, analytics dashboard and reports are currently compiling in the background." FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="PrintModal" Visibility="Collapsed" Grid.ColumnSpan="4" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="10">
            <Border Style="{StaticResource GlassCard}" Width="850" MinHeight="530" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" BorderBrush="{DynamicResource InputBorder}" Background="{DynamicResource CardBg}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="PrinterSettings" Foreground="#06B6D4" Width="26" Height="26" VerticalAlignment="Center"/>
                            <TextBlock Text="BROADCAST PRINT SETTINGS" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <TextBlock Text="Select Output Printers:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource ItemSelectedBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,15" Height="100">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ListOutputPrinters">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="{DynamicResource TextPrimary}" Margin="5,3" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paper Size:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbPaperSize" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}">
                                    <ComboBoxItem Content="Letter (8.5 x 11)" IsSelected="True"/>
                                    <ComboBoxItem Content="A4"/>
                                    <ComboBoxItem Content="Legal (8.5 x 14)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Orientation:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbOrientation" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Portrait" IsSelected="True"/>
                                    <ComboBoxItem Content="Landscape"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        
                        <Button x:Name="BtnToggleAdvanced" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#06B6D4" HorizontalAlignment="Left" Margin="-10,0,0,10" Click="BtnToggleAdvanced_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Settings" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="ADVANCED SETTINGS" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        
                        <StackPanel x:Name="AdvancedSection" Visibility="Collapsed" Margin="0,0,0,15">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Layout (N-up):" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbLayout" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="1-up (Standard)" IsSelected="True"/>
                                        <ComboBoxItem Content="2-up (Side by Side)"/>
                                        <ComboBoxItem Content="4-up (Grid Layout)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Auto-Heal Check Interval:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtMaintTime" Text="07:00" Width="80" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="4" ToolTip="Format HH:mm (24hr)"/>
                                        <TextBlock Text=" (24h)" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextDim}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Extra Dimensions:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbPaperSizeAdvanced" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="--- Select Extra ---" IsSelected="True"/>
                                        <ComboBoxItem Content="Statement (5.5 x 8.5)"/>
                                        <ComboBoxItem Content="Executive (7.25 x 10.5)"/>
                                        <ComboBoxItem Content="Folio (8.5 x 13)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Print Quality:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbPrintQuality" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="Normal" IsSelected="True"/>
                                        <ComboBoxItem Content="Draft (Eco)"/>
                                        <ComboBoxItem Content="High (Best)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Color Mode:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbColorMode" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Color" IsSelected="True"/>
                                    <ComboBoxItem Content="Grayscale"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Scaling:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbScaling" Style="{StaticResource DarkComboBox}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="UpdatePrintPreview_SelectionChanged">
                                    <ComboBoxItem Content="Fit to Page" IsSelected="True"/>
                                    <ComboBoxItem Content="Actual Size"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Copies per Printer:" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="-" Width="40" Height="30" Click="BtnMinusCopy_Click" Background="{DynamicResource NavActiveBorder}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCopies" Text="1" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="15,0" Foreground="{DynamicResource TextPrimary}"/>
                                <Button Content="+" Width="40" Height="30" Click="BtnPlusCopy_Click" Background="{DynamicResource NavActiveBorder}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="CANCEL" Height="45" FontWeight="Bold" Click="BtnCancelPrint_Click" Background="Transparent" BorderBrush="#F43F5E" BorderThickness="1.5" Foreground="#F43F5E"/>
                            <Button Grid.Column="2" Content="CONFIRM" Height="45" FontWeight="Bold" Click="BtnConfirmPrint_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource DeepBg}" Padding="15">
                        <Grid>
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="2">
                                <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPdfPreviewMessage" Text="(Settings won't apply to PDF files)" FontSize="9" FontStyle="Italic" Foreground="#06B6D4" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="PaperPreviewBorder" Background="#FFFFFF" Width="260" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="ImgPrintPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                                    <WebBrowser x:Name="PdfPrintPreview" Margin="0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewConverter" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColConvLeft" Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="CONVERTER ENGINE" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Convert any document to PDF format" FontSize="10" Foreground="#06B6D4" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="OUTPUT DIRECTORY" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConverterDestPath" Grid.Column="0" Text="C:\ScannedDocuments" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="10,8" FontSize="11" IsReadOnly="True"/>
                                <Button x:Name="BtnConverterBrowse" Grid.Column="1" Content="Browse" Height="36" Padding="12,0" Background="{DynamicResource NavActiveBorder}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold" Margin="0" Click="BtnConverterBrowse_Click"/>
                            </Grid>

                            <TextBlock Text="CONVERSION SETTINGS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                            
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Page Size" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbConverterPageSize" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="A4 (Standard)" IsSelected="True"/>
                                    <ComboBoxItem Content="Letter"/>
                                    <ComboBoxItem Content="Auto (Match Image Size)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Page Orientation" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbConverterOrientation" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="Portrait" IsSelected="True"/>
                                    <ComboBoxItem Content="Landscape"/>
                                </ComboBox>
                            </StackPanel>

                            <CheckBox x:Name="ChkConverterOpenAfter" Content="Open PDF in Reader upon success" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,10,0,25"/>

                            <Border Height="1" Background="{DynamicResource InputBg}" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="SUPPORTED FORMATS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource BatchBg}" CornerRadius="8" Padding="15,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="• Images: PNG, JPG, JPEG, BMP" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Text Files: TXT, LOG, CSV, JSON, XML" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Word Docs: DOCX (with XML Fallback)" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Excel/PPT: XLSX, PPTX (COM only)" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="35,20,35,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="BorderDropArea" Grid.Row="0" BorderBrush="#06B6D4" BorderThickness="2" CornerRadius="12" Background="{DynamicResource CardBg}" Margin="0,0,0,20" AllowDrop="True" DragEnter="BorderDropArea_DragEnter" DragLeave="BorderDropArea_DragLeave" DragOver="BorderDropArea_DragOver" Drop="BorderDropArea_Drop" MouseLeftButtonDown="BorderDropArea_MouseLeftButtonDown" Cursor="Hand">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="IconUpload" Kind="CloudUploadOutline" Foreground="#06B6D4" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="Drag &amp; Drop Files Here" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="or click to browse from system" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="BorderFileInfo" Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <materialDesign:PackIcon x:Name="IconFileType" Kind="FileOutline" Foreground="#06B6D4" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFileName" Text="filename.docx" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="TxtFileSize" Text="156 KB" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="TxtFileTypeDesc" Text="Word Document" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="BtnClearFile" Style="{StaticResource MaterialDesignToolButton}" Width="36" Height="36" Padding="0" Click="BtnClearFile_Click" ToolTip="Remove file" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloseCircle" Foreground="{DynamicResource TextMuted}" Width="22" Height="22"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="CONVERSION LOGS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource DeepestBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="15" Margin="0,0,0,15" Height="120">
                        <ScrollViewer x:Name="ScrollConverterLogs" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtConverterConsole" FontFamily="Consolas, Courier New, monospace" FontSize="11" Foreground="{DynamicResource ConsoleFg}" LineHeight="18" TextWrapping="Wrap" Text="Console idle. Drop a file to begin."/>
                        </ScrollViewer>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="TxtConverterStatus" Text="Ready to Convert" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                            <ProgressBar x:Name="ProgressConverter" Height="8" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource InputBg}" Foreground="#06B6D4"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="BtnStartConversion" Height="48" FontWeight="Bold" FontSize="13" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Click="BtnStartConversion_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogPlay" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="CONVERT TO PDF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ViewPrinters" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColPrintLeft" Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RightPanelBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="PRINTER CENTER" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Diagnostics and Consumables Monitor" FontSize="9.5" Foreground="#06B6D4" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="INSTALLED PRINTERS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                            
                            <ListBox x:Name="ListPrinterCenterDevices" Background="Transparent" BorderThickness="0" Margin="0,0,0,15" SelectionChanged="ListPrinterCenterDevices_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,8" BorderThickness="1" BorderBrush="{DynamicResource BorderLine}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                                <Setter Property="BorderBrush" Value="#06B6D4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Printer" Foreground="#06B6D4" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Grid.Column="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="{DynamicResource WindowBg}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                        <Setter Property="Background" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnSetDefaultPrinter" Content="SET DEFAULT" Height="36" FontSize="11" FontWeight="Black" Click="BtnSetDefaultPrinter_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                <Button Grid.Column="2" x:Name="BtnAddWifiPrinter" Content="ADD PRINTER" Height="36" FontSize="11" FontWeight="Black" Click="BtnAddWifiPrinter_Click" Background="{StaticResource AccentGreen}" BorderBrush="Transparent" Foreground="{DynamicResource SidebarBg}"/>
                            </Grid>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="INK / TONER LEVELS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtInkStatusLabel" Text="{Binding SelectedItem.InkStatus, ElementName=ListPrinterCenterDevices}" FontSize="9" FontWeight="Bold" Foreground="#EAB308" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="Cyan" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedItem.TonerCyan, ElementName=ListPrinterCenterDevices, StringFormat={}{0:0}%}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedItem.TonerCyan, ElementName=ListPrinterCenterDevices}" Foreground="#06B6D4" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="Magenta" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedItem.TonerMagenta, ElementName=ListPrinterCenterDevices, StringFormat={}{0:0}%}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedItem.TonerMagenta, ElementName=ListPrinterCenterDevices}" Foreground="#EC4899" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="Yellow" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedItem.TonerYellow, ElementName=ListPrinterCenterDevices, StringFormat={}{0:0}%}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedItem.TonerYellow, ElementName=ListPrinterCenterDevices}" Foreground="#EAB308" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <Grid>
                                            <TextBlock Text="Black" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedItem.TonerBlack, ElementName=ListPrinterCenterDevices, StringFormat={}{0:0}%}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedItem.TonerBlack, ElementName=ListPrinterCenterDevices}" Foreground="#475569" Background="{DynamicResource InputBg}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="BtnRefillToner" Content="REFILL TONER CARTRIDGES" Height="36" FontSize="11" FontWeight="Black" Click="BtnRefillToner_Click" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource NavActiveBorder}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="25,20,25,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="ACTIVE PRINT QUEUE" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Manage jobs in the selected printer spool" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,0,12">
                    <DataGrid x:Name="GridPrinterCenterJobs" Background="Transparent" BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="None" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBg}"/>
                                <Setter Property="Padding" Value="5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="65"/>
                            <DataGridTextColumn Header="Document Name" Binding="{Binding DocumentName}" Width="*"/>
                            <DataGridTextColumn Header="Pages" Binding="{Binding TotalPages}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Submitter" Binding="{Binding Submitter}" Width="120"/>
                            <DataGridTextColumn Header="Submitted" Binding="{Binding TimeSubmitted}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnPrinterJobPause" Content="PAUSE" Height="36" Padding="15,0" Click="BtnPrinterJobPause_Click" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnPrinterJobResume" Content="RESUME" Height="36" Padding="15,0" Click="BtnPrinterJobResume_Click" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnPrinterJobCancel" Content="CANCEL JOB" Height="36" Padding="15,0" Click="BtnPrinterJobCancel_Click" Background="Transparent" BorderBrush="#F43F5E" BorderThickness="1.5" Foreground="#F43F5E"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnPrinterJobRefresh" Height="36" Padding="15,0" Click="BtnPrinterJobRefresh_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="REFRESH" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SPOOLER SERVICE STATUS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource BatchBg}" CornerRadius="8" Padding="15,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Spooler Service" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtSpoolerServiceStatus" Grid.Column="1" Text="RUNNING" FontSize="11" Foreground="#10B981" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Diagnostics Lock" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="MONITORING" FontSize="11" Foreground="#06B6D4" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnHealSpooler" Content="HEAL SPOOLER ENGINE" Height="40" FontSize="11" FontWeight="Black" Click="BtnHealSpooler_Click" Background="{StaticResource AccentRed}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HEALING STATUS AUDIT" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource DeepestBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="12" Height="120">
                                <ScrollViewer x:Name="ScrollPrinterHealLogs" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtPrinterHealConsole" FontFamily="Consolas, Courier New, monospace" FontSize="10" Foreground="{DynamicResource ConsoleFg}" LineHeight="16" TextWrapping="Wrap" Text="Maintenance engine standby.&#x0a;Click HEAL SPOOLER to test."/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="AlertModal" Visibility="Collapsed" Grid.ColumnSpan="4" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="10">
            <Border Style="{StaticResource GlassCard}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" BorderBrush="#EF4444" Background="{DynamicResource CardBg}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF4444" Width="30" Height="30" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAlertTitle" Text="SYSTEM ALERT" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAlertMessage" Text="Alert message details." FontSize="14" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="20"/>
                    <Button Content="OK, GOT IT" Height="42" FontSize="14" FontWeight="Bold" Click="BtnCloseAlert_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" Width="120"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ProfileModal" Visibility="Collapsed" Grid.ColumnSpan="4" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="10" MouseDown="ProfileModalBg_MouseDown">
            <Border Style="{StaticResource GlassCard}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource CardBg}" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PopupBg}" CornerRadius="16,16,0,0" Padding="25,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" CornerRadius="25" Width="50" Height="50" Background="{DynamicResource AvatarBg}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock x:Name="TxtProfileAvatarLarge" Text="JB" Foreground="{DynamicResource AvatarText}" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProfileModalName" Text="James Michael G. Biaton II" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="Active Settings Session" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnCloseProfile_Click" ToolTip="Close" VerticalAlignment="Top">
                                <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <StackPanel Margin="25,20,25,10">
                            
                            <TextBlock Text="PROFILE INFORMATION" FontSize="10" FontWeight="Black" Foreground="#06B6D4" Margin="0,0,0,12"/>
                            
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Display Name" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtEditProfileName" Text="James Michael G. Biaton II" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="10,8" FontSize="12"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource InputBg}" Margin="0,10,0,18"/>

                            <TextBlock Text="APP PREFERENCES" FontSize="10" FontWeight="Black" Foreground="#06B6D4" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Default Scanner Source" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbProfileScanner" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="WIA (Windows Image Acquisition)" IsSelected="True"/>
                                    <ComboBoxItem Content="TWAIN (Legacy)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Library Storage Path" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtProfileLibPath" Grid.Column="0" Text="" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="10,8" FontSize="11" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse" Height="36" Padding="12,0" Background="{DynamicResource NavActiveBorder}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" Click="BtnProfileBrowseLib_Click"/>
                                </Grid>
                            </StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Auto-Heal on Startup" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbProfileAutoHeal" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Enabled" IsSelected="True"/>
                                        <ComboBoxItem Content="Disabled"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default Color Mode" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbProfileColorMode" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Color" IsSelected="True"/>
                                        <ComboBoxItem Content="Grayscale"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Application Theme" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbProfileTheme" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbProfileTheme_SelectionChanged">
                                    <ComboBoxItem Content="Dark Mode (Default)" IsSelected="True"/>
                                    <ComboBoxItem Content="Light Mode"/>
                                </ComboBox>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource InputBg}" Margin="0,10,0,18"/>

                            <TextBlock Text="SYSTEM INFORMATION" FontSize="10" FontWeight="Black" Foreground="#06B6D4" Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource BatchBg}" CornerRadius="8" Padding="15,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Application" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="NEXUS SCAN Auto-Heal Engine" FontSize="10" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Version" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="2.0.1 (Build 2026.05)" FontSize="10" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Machine" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtProfileMachine" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OS" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtProfileOS" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource InputBg}" BorderThickness="0,1,0,0" Padding="25,15" CornerRadius="0,0,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="CANCEL" Height="40" FontWeight="Bold" Click="BtnCloseProfile_Click" Background="Transparent" BorderBrush="{DynamicResource TextDarker}" BorderThickness="1.5" Foreground="{DynamicResource TextMuted}"/>
                            <Button Grid.Column="2" Content="SAVE CHANGES" Height="40" FontWeight="Bold" Click="BtnSaveProfile_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AddPrinterModal" Visibility="Collapsed" Grid.ColumnSpan="4" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="10">
            <Border Style="{StaticResource GlassCard}" Width="650" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" BorderBrush="{DynamicResource InputBorder}" Background="{DynamicResource CardBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterSearch" Foreground="#10B981" Width="26" Height="26" VerticalAlignment="Center"/>
                            <TextBlock Text="ADD WI-FI / NETWORK PRINTER" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="BtnCloseAddPrinterModal_Click" ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextMuted}" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- Search Status & Progress Bar -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock x:Name="TxtAddPrinterScanStatus" Text="Scanning local Wi-Fi network..." FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAddPrinterProgressPercent" Text="0%" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressAddPrinterScan" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="{DynamicResource InputBg}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Discovered Printers List -->
                    <Border Grid.Row="2" Background="{DynamicResource DeepestBg}" BorderBrush="{DynamicResource InputBg}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,0,15">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel x:Name="PanelAddPrinterEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <materialDesign:PackIcon Kind="WifiOff" Width="48" Height="48" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="No Wi-Fi printers discovered yet" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Scanning IP addresses in your local subnet..." FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ListBox of Discovered Printers -->
                            <ListBox x:Name="ListDiscoveredPrinters" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,6,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,8" BorderThickness="1" BorderBrush="{DynamicResource BorderLine}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Printer Icon -->
                                            <Border Grid.Column="0" Background="{DynamicResource NavActiveBg}" CornerRadius="6" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Printer" Foreground="#10B981" Width="20" Height="20"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding IpAddress}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text=" • " FontSize="10.5" Foreground="{DynamicResource TextDim}"/>
                                                    <TextBlock Text="{Binding Protocol}" FontSize="10.5" Foreground="#06B6D4" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="INSTALL" Height="30" Padding="15,0" Click="BtnInstallDiscoveredPrinter_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Content" Value="INSTALLING..."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Diagnostic/Log message -->
                    <TextBlock Grid.Row="3" x:Name="TxtAddPrinterLog" Text="" FontSize="11" Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas, monospace" TextWrapping="Wrap" Margin="0,0,0,15" MaxHeight="40" VerticalAlignment="Center"/>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="NATIVE WIZARD" Height="40" Click="BtnLaunchWindowsWizard_Click" Background="Transparent" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold" ToolTip="Launch native Windows Add Printer wizard for Wi-Fi/Bluetooth/WSD discovery"/>
                        <Button Grid.Column="2" Content="RESCAN NETWORK" x:Name="BtnRescanNetwork" Height="40" Click="BtnRescanNetwork_Click" Background="{StaticResource AccentBlue}" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="OverlayModal" Visibility="Collapsed" Grid.ColumnSpan="4" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="200" Height="200" Margin="0,0,0,25">
                    <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" Maximum="100" Width="200" Height="200" Foreground="#06B6D4"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Black" Foreground="#06B6D4"/>
                </Grid>
                <TextBlock x:Name="TxtModalMessage" Text="Accessing scanner hardware..." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>